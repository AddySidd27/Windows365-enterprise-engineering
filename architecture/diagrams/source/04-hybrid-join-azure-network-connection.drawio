<mxCell id="t105" value="AD-integrated DNS" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontFamily=Segoe UI;fontSize=15;fontColor=#364152;" vertex="1" parent="1"><mxGeometry x="2131" y="967" width="159" height="20" as="geometry"/></mxCell>
<mxCell id="t106" value="(two or more servers)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontFamily=Segoe UI;fontSize=15;fontColor=#364152;" vertex="1" parent="1"><mxGeometry x="2121" y="992" width="179" height="20" as="geometry"/></mxCell>
<mxCell id="t107" value="Group Policy or Intune" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontFamily=Segoe UI;fontSize=15;fontColor=#364152;" vertex="1" parent="1"><mxGeometry x="2119" y="1017" width="182" height="20" as="geometry"/></mxCell>
<mxCell id="t108" value="Directory synchronization" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontFamily=Segoe UI;fontSize=14;fontColor=#744da9;" vertex="1" parent="1"><mxGeometry x="1742" y="382" width="195" height="18" as="geometry"/></mxCell>
<mxCell id="t109" value="Terms used in this diagram" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontFamily=Segoe UI;fontSize=17;fontColor=#172b4d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="73" y="1145" width="276" height="22" as="geometry"/></mxCell>
<mxCell id="t110" value="DNS (Domain Name System): turns names into IP addresses." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontFamily=Segoe UI;fontSize=14;fontColor=#364152;" vertex="1" parent="1"><mxGeometry x="73" y="1178" width="443" height="18" as="geometry"/></mxCell>
<mxCell id="t111" value="NSG (network security group): allow or deny rules for network traffic." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontFamily=Segoe UI;fontSize=14;fontColor=#364152;" vertex="1" parent="1"><mxGeometry x="73" y="1204" width="501" height="18" as="geometry"/></mxCell>
<mxCell id="t112" value="UDR (user-defined route): your own route that overrides default routing." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontFamily=Segoe UI;fontSize=14;fontColor=#364152;" vertex="1" parent="1"><mxGeometry x="73" y="1230" width="522" height="18" as="geometry"/></mxCell>
<mxCell id="t113" value="Firewall / NVA (network virtual appliance): a firewall or inspection device you run." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontFamily=Segoe UI;fontSize=14;fontColor=#364152;" vertex="1" parent="1"><mxGeometry x="73" y="1256" width="586" height="18" as="geometry"/></mxCell>
<mxCell id="t114" value="NAT gateway: outbound internet access; new ANC VNets need an explicit outbound method." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontFamily=Segoe UI;fontSize=14;fontColor=#364152;" vertex="1" parent="1"><mxGeometry x="73" y="1282" width="663" height="18" as="geometry"/></mxCell>
<mxCell id="t115" value="ANC (Azure network connection): tells Windows 365 which subscription, VNet, and subnet to use." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontFamily=Segoe UI;fontSize=14;fontColor=#364152;" vertex="1" parent="1"><mxGeometry x="1206" y="1178" width="698" height="18" as="geometry"/></mxCell>
<mxCell id="t116" value="VNet: virtual network.  NIC: virtual network card of the Cloud PC." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontFamily=Segoe UI;fontSize=14;fontColor=#364152;" vertex="1" parent="1"><mxGeometry x="1206" y="1204" width="470" height="18" as="geometry"/></mxCell>
<mxCell id="t117" value="AVD (Azure Virtual Desktop) gateway and broker: route the session and match user to Cloud PC." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontFamily=Segoe UI;fontSize=14;fontColor=#364152;" vertex="1" parent="1"><mxGeometry x="1206" y="1230" width="691" height="18" as="geometry"/></mxCell>
<mxCell id="t118" value="Reverse connect: the Cloud PC dials out, so no inbound port is opened." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontFamily=Segoe UI;fontSize=14;fontColor=#364152;" vertex="1" parent="1"><mxGeometry x="1206" y="1256" width="514" height="18" as="geometry"/></mxCell>
<mxCell id="t119" value="AD DS: Active Directory Domain Services.  OU: organizational unit.  GPO: Group Policy." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontFamily=Segoe UI;fontSize=14;fontColor=#364152;" vertex="1" parent="1"><mxGeometry x="1206" y="1282" width="621" height="18" as="geometry"/></mxCell>
<mxCell id="t120" value="Microsoft Entra hybrid join needs AD DS name resolution (VNet DNS) and a path to a domain controller for provisioning and sign-in." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#172b4d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="605" y="1364" width="1210" height="21" as="geometry"/></mxCell>
<mxCell id="t121" value="The VNet region sets where the Cloud PC runs. Keep Windows 365 and AVD service endpoints reachable over supported outbound paths." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontFamily=Segoe UI;fontSize=15;fontColor=#364152;" vertex="1" parent="1"><mxGeometry x="686" y="1393" width="1047" height="20" as="geometry"/></mxCell>
<mxCell id="t122" value="No inbound internet path is used for normal Cloud PC access; users connect through AVD reverse connect." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontFamily=Segoe UI;fontSize=15;fontColor=#364152;" vertex="1" parent="1"><mxGeometry x="801" y="1421" width="817" height="20" as="geometry"/></mxCell>
<mxCell id="t123" value="Microsoft Entra Domain Services isn't supported for the Microsoft Entra hybrid join model." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontFamily=Segoe UI;fontSize=15;fontColor=#364152;" vertex="1" parent="1"><mxGeometry x="865" y="1449" width="691" height="20" as="geometry"/></mxCell>
<mxCell id="t124" value="Source: Microsoft Learn, Windows 365 network deployment options (learn.microsoft.com/windows-365/enterprise/windows-365-network-deployment-options)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontFamily=Segoe UI;fontSize=13;fontColor=#5c6675;" vertex="1" parent="1"><mxGeometry x="51" y="1504" width="1042" height="17" as="geometry"/></mxCell>
