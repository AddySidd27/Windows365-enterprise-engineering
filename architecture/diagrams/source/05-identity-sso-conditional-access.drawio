<mxfile host="app.diagrams.net" modified="2026-09-03T00:00:00.000Z" agent="Codex" version="24.7.17"><diagram id="w365-signin-ca" name="Windows 365 Sign-in and CA"><mxGraphModel dx="1800" dy="900" grid="1" gridSize="10" guides="1" page="1" pageWidth="1800" pageHeight="900"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="title" value="Windows 365 User Sign-in and Conditional Access Flow" style="text;html=1;fontFamily=Segoe UI;fontSize=30;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="45" y="20" width="1400" height="50" as="geometry"/></mxCell>
<mxCell id="subtitle" value="Connecting-device compliance, Microsoft Entra access controls, Windows 365 resources, SSO, and Cloud PC sign-in" style="text;html=1;fontFamily=Segoe UI;fontSize=16;fontColor=#5C6675;" vertex="1" parent="1"><mxGeometry x="45" y="70" width="1400" height="35" as="geometry"/></mxCell>
<mxCell id="flowBoundary" value="&lt;b&gt;User connection flow&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=16;spacingLeft=22;fontFamily=Segoe UI;fontSize=20;fontStyle=1;fillColor=#FFFFFF;strokeColor=#264A8A;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="35" y="125" width="1730" height="590" as="geometry"/></mxCell>
<mxCell id="endpoint" value="&lt;b&gt;1. User endpoint&lt;/b&gt;&lt;br&gt;Windows App or&lt;br&gt;windows.cloud.microsoft&lt;br&gt;&lt;br&gt;Connecting device requests Windows 365 access" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=14;fillColor=#FFFFFF;strokeColor=#8A94A6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="55" y="330" width="240" height="190" as="geometry"/></mxCell>
<mxCell id="entra" value="&lt;b&gt;2. Microsoft Entra ID&lt;br&gt;&lt;font color='#744DA9'&gt;Conditional Access&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Authenticates the user and evaluates policy&lt;br&gt;&lt;br&gt;Lab: MFA report-only&lt;br&gt;Next: compliant-device pilot" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=14;fillColor=#F8F4FC;strokeColor=#744DA9;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="360" y="305" width="270" height="240" as="geometry"/></mxCell>
<mxCell id="w365" value="&lt;b&gt;3. Windows 365&lt;/b&gt;&lt;br&gt;&lt;br&gt;Lists assigned Cloud PCs and supports actions such as Restart&lt;br&gt;&lt;br&gt;Resource app" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=14;fillColor=#EEF8FF;strokeColor=#0078D4;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="695" y="330" width="240" height="190" as="geometry"/></mxCell>
<mxCell id="gateway" value="&lt;b&gt;4. Gateway&lt;/b&gt;&lt;br&gt;&lt;br&gt;Authenticates the Cloud PC connection&lt;br&gt;&lt;br&gt;&lt;font color='#CA5010'&gt;Conditional Access app: Azure Virtual Desktop&lt;br&gt;May also appear as Windows Virtual Desktop&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=14;fillColor=#EEF8FF;strokeColor=#0078D4;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1000" y="330" width="240" height="190" as="geometry"/></mxCell>
<mxCell id="wcl" value="&lt;b&gt;5. Windows Cloud Login&lt;/b&gt;&lt;br&gt;&lt;br&gt;Authenticates the user to the Cloud PC&lt;br&gt;&lt;br&gt;&lt;font color='#107C10'&gt;Used when SSO is enabled&lt;/font&gt;&lt;br&gt;No second credential prompt" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=14;fillColor=#F8F4FC;strokeColor=#744DA9;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1305" y="330" width="240" height="190" as="geometry"/></mxCell>
<mxCell id="cloudpc" value="&lt;b&gt;&lt;font color='#107C10'&gt;6. Cloud PC&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Windows desktop&lt;br&gt;&lt;br&gt;Session starts" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=14;fillColor=#F2FBF2;strokeColor=#107C10;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1600" y="330" width="135" height="190" as="geometry"/></mxCell>
<mxCell id="intune" value="&lt;b&gt;Microsoft Intune&lt;/b&gt;&lt;br&gt;Connecting-device compliance" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=14;fillColor=#EEF8FF;strokeColor=#0078D4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="360" y="195" width="270" height="82" as="geometry"/></mxCell>
<mxCell id="matching" value="Use matching Conditional Access intent across the relevant resource apps" style="text;html=1;fontFamily=Segoe UI;fontSize=12;fontColor=#744DA9;align=center;" vertex="1" parent="1"><mxGeometry x="825" y="255" width="520" height="35" as="geometry"/></mxCell>
<mxCell id="targets" value="&lt;b&gt;Conditional Access target resources&lt;/b&gt;&lt;br&gt;Windows 365 — portal, Cloud PC list, and service actions      Azure Virtual Desktop — gateway connection      Windows Cloud Login — Cloud PC authentication with SSO&lt;br&gt;&lt;font color='#CA5010'&gt;Start in report-only mode. Validate the pilot user, emergency-account exclusion, What If results, and Entra sign-in logs before enforcement.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=14;fillColor=#F7F9FB;strokeColor=#8A94A6;strokeWidth=2;spacing=12;" vertex="1" parent="1"><mxGeometry x="35" y="745" width="1730" height="110" as="geometry"/></mxCell>
<mxCell id="learnBasis" value="Microsoft Learn basis: Set Conditional Access policies for Windows 365." style="text;html=1;fontFamily=Segoe UI;fontSize=12;fontColor=#5C6675;align=center;" vertex="1" parent="1"><mxGeometry x="430" y="865" width="940" height="25" as="geometry"/></mxCell>
<mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563A9;strokeWidth=5;endArrow=block;endFill=1;" edge="1" parent="1" source="endpoint" target="entra"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563A9;strokeWidth=5;endArrow=block;endFill=1;" edge="1" parent="1" source="entra" target="w365"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563A9;strokeWidth=5;endArrow=block;endFill=1;" edge="1" parent="1" source="w365" target="gateway"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="SSO" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#107C10;strokeWidth=5;endArrow=block;endFill=1;fontColor=#107C10;" edge="1" parent="1" source="gateway" target="wcl"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#107C10;strokeWidth=5;endArrow=block;endFill=1;" edge="1" parent="1" source="wcl" target="cloudpc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" value="Compliance signal" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#744DA9;strokeWidth=4;endArrow=block;endFill=1;fontColor=#744DA9;" edge="1" parent="1" source="intune" target="entra"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" value="Without SSO: Cloud PC credentials are prompted" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#CA5010;strokeWidth=3;endArrow=block;endFill=1;fontColor=#CA5010;" edge="1" parent="1" source="gateway" target="cloudpc"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1120" y="620"/><mxPoint x="1667" y="620"/></Array></mxGeometry></mxCell>
</root></mxGraphModel></diagram></mxfile>
