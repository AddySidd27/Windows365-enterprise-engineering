        <mxCell id="flowTitle" value="Architecture flows" style="text;html=1;fontFamily=Segoe UI;fontSize=18;fontStyle=1;fontColor=#172B4D;align=left;" vertex="1" parent="1"><mxGeometry x="65" y="900" width="260" height="30" as="geometry"/></mxCell>
        <mxCell id="flowAuth" value="1  User authenticates with Microsoft Entra ID&lt;br&gt;2  Conditional Access evaluates MFA, risk, and device signals&lt;br&gt;3  Windows 365 authorizes the resource&lt;br&gt;4–6  AVD brokers a reverse-connect session" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fontColor=#172B4D;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="65" y="940" width="515" height="105" as="geometry"/></mxCell>
        <mxCell id="flowMgmt" value="7  Intune applies management and compliance&lt;br&gt;8  ANC injects the Cloud PC vNIC into the customer VNet&lt;br&gt;Admin: Entra = identity/CA • Intune = Cloud PCs/devices • M365 = licenses • Azure = ANC network" style="text;html=1;whiteSpace=wrap;fontFamily=Segoe UI;fontSize=13;fontColor=#172B4D;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="610" y="940" width="720" height="105" as="geometry"/></mxCell>
        <mxCell id="legendAuth" value="Authentication and session" style="text;html=1;fontFamily=Segoe UI;fontSize=13;fontColor=#0078D4;align=left;" vertex="1" parent="1"><mxGeometry x="1380" y="920" width="230" height="25" as="geometry"/></mxCell>
        <mxCell id="legendMgmt" value="Management" style="text;html=1;fontFamily=Segoe UI;fontSize=13;fontColor=#744DA9;align=left;" vertex="1" parent="1"><mxGeometry x="1380" y="955" width="230" height="25" as="geometry"/></mxCell>
        <mxCell id="legendAnc" value="ANC network path" style="text;html=1;fontFamily=Segoe UI;fontSize=13;fontColor=#107C10;align=left;" vertex="1" parent="1"><mxGeometry x="1380" y="990" width="230" height="25" as="geometry"/></mxCell>
