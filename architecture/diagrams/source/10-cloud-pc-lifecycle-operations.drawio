<mxfile host="app.diagrams.net" modified="2026-09-03T00:00:00.000Z" agent="Mozilla/5.0" version="24.7.17"><diagram id="lifecycle10" name="Cloud PC lifecycle operations"><mxGraphModel dx="1900" dy="1120" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1120" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
	<mxCell id="title" value="Windows 365 Enterprise Cloud PC Lifecycle Operations" style="text;html=1;align=center;verticalAlign=middle;fontSize=30;fontStyle=1;fontColor=#17365D;" vertex="1" parent="1"><mxGeometry x="350" y="20" width="1200" height="50" as="geometry"/></mxCell>
	<mxCell id="subtitle" value="Choose the least disruptive documented action, protect data, monitor the service, and validate the result" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="300" y="70" width="1300" height="32" as="geometry"/></mxCell>
<mxCell id="req" value="&lt;b&gt;1 Operational requirement&lt;/b&gt;&lt;br&gt;Identify the user, Cloud PC, current state, and required outcome." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F3FB;strokeColor=#0078D4;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="70" y="130" width="360" height="120" as="geometry"/></mxCell>
<mxCell id="safe" value="&lt;b&gt;2 Safety gate&lt;/b&gt;&lt;br&gt;Notify user • save and sign out&lt;br&gt;Protect data • baseline • approval" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F3FB;strokeColor=#0078D4;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="515" y="130" width="390" height="120" as="geometry"/></mxCell>
<mxCell id="act" value="&lt;b&gt;3 Select and run action&lt;/b&gt;&lt;br&gt;Run the selected Windows 365 action and monitor its status." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F3FB;strokeColor=#0078D4;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="990" y="130" width="360" height="120" as="geometry"/></mxCell>
<mxCell id="val" value="&lt;b&gt;4 Validate and record&lt;/b&gt;&lt;br&gt;Access • management • compliance&lt;br&gt;Security • apps • data • evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F3FB;strokeColor=#0078D4;fontSize=16;spacing=12;" vertex="1" parent="1"><mxGeometry x="1435" y="130" width="395" height="120" as="geometry"/></mxCell>
<mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#64748B;strokeWidth=2;" edge="1" parent="1" source="req" target="safe"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#64748B;strokeWidth=2;" edge="1" parent="1" source="safe" target="act"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#64748B;strokeWidth=2;" edge="1" parent="1" source="act" target="val"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="lane" value="&lt;b&gt;Choose one action that retains the existing Cloud PC&lt;/b&gt;&lt;br&gt;No reprovision. Service and user impact differs by action." style="swimlane;html=1;rounded=1;startSize=80;horizontal=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontSize=18;fontColor=#17365D;align=left;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="70" y="320" width="1760" height="425" as="geometry"/></mxCell>
	<mxCell id="restart" value="&lt;b&gt;Restart&lt;/b&gt;&lt;br&gt;&lt;br&gt;Standard operating-system reboot&lt;br&gt;• Stored data retained&lt;br&gt;• Short session interruption&lt;br&gt;• Unsaved work can be lost" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=2;fontSize=17;spacing=18;" vertex="1" parent="1"><mxGeometry x="105" y="435" width="390" height="245" as="geometry"/></mxCell>
	<mxCell id="resize" value="&lt;b&gt;Resize&lt;/b&gt;&lt;br&gt;&lt;br&gt;Change CPU, RAM, or disk capacity&lt;br&gt;• User and disk data retained&lt;br&gt;• Disk increase only&lt;br&gt;• GPU Cloud PCs unsupported" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=2;fontSize=17;spacing=18;" vertex="1" parent="1"><mxGeometry x="535" y="435" width="390" height="245" as="geometry"/></mxCell>
<mxCell id="move" value="&lt;b&gt;Move&lt;/b&gt;&lt;br&gt;&lt;br&gt;Supported region or network change&lt;br&gt;• Existing Cloud PC retained&lt;br&gt;• Join type cannot change&lt;br&gt;• Old restore points deleted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=2;fontSize=17;spacing=18;" vertex="1" parent="1"><mxGeometry x="965" y="435" width="390" height="245" as="geometry"/></mxCell>
	<mxCell id="restore" value="&lt;b&gt;Point-in-time Restore&lt;/b&gt;&lt;br&gt;&lt;br&gt;Return to a selected earlier state&lt;br&gt;• Same Cloud PC retained&lt;br&gt;• Later local changes are lost&lt;br&gt;• Credential conflicts are possible" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#107C10;strokeWidth=2;fontSize=17;spacing=18;" vertex="1" parent="1"><mxGeometry x="1395" y="435" width="390" height="245" as="geometry"/></mxCell>
	<mxCell id="destructive" value="&lt;b&gt;Reprovision — destructive&lt;/b&gt;&lt;br&gt;&lt;br&gt;Wipe the current Cloud PC and build a new one from the current provisioning policy.&lt;br&gt;&lt;br&gt;&lt;b&gt;Required controls:&lt;/b&gt; explicit approval • protected user data • exported evidence • healthy current policy&lt;br&gt;All local data, apps, and customizations are deleted. A new device name is common.&lt;br&gt;After completion, validate the result as a new managed device." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF4F4;strokeColor=#D13438;strokeWidth=2;fontSize=18;spacing=20;align=left;" vertex="1" parent="1"><mxGeometry x="70" y="790" width="1760" height="225" as="geometry"/></mxCell>
<mxCell id="legend" value="Legend: blue = operating workflow • green = existing Cloud PC retained • red = wipe and rebuild" style="text;html=1;align=left;fontSize=15;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="70" y="1050" width="1200" height="35" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
