<mxfile host="app.diagrams.net" modified="2026-09-03T00:00:00.000Z" agent="Codex" version="24.7.17"><diagram id="w365-intune-delivery" name="Intune Management and Policy Delivery"><mxGraphModel dx="1900" dy="1050" grid="1" gridSize="10" guides="1" page="1" pageWidth="1900" pageHeight="1050"><root>
