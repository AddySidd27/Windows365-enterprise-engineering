<mxCell id="cloudpc" value="&lt;b&gt;&lt;font color='#107C10'&gt;5. Windows 365 Cloud PC&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Microsoft Entra joined and enrolled in Intune&lt;br&gt;Receives policies and apps at check-in&lt;br&gt;Company Portal supports self-service apps and Check access" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=14;fillColor=#F2FBF2;strokeColor=#107C10;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="610" y="775" width="500" height="160" as="geometry"/></mxCell>
<mxCell id="mupdate" value="&lt;b&gt;Microsoft Update service&lt;/b&gt;&lt;br&gt;&lt;br&gt;Cloud PC downloads Windows update content from Microsoft" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=14;fillColor=#EEF8FF;strokeColor=#0078D4;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1320" y="785" width="400" height="140" as="geometry"/></mxCell>
	<mxCell id="note" value="Intune sends update policy, not update binaries. Reporting can lag behind device check-in and workload processing." style="text;html=1;fontFamily=Segoe UI;fontSize=12;fontColor=#CA5010;" vertex="1" parent="1"><mxGeometry x="65" y="940" width="1050" height="35" as="geometry"/></mxCell>
