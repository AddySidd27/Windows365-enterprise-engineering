<mxCell id="title" value="Intune Management and Policy Delivery for Windows 365 Cloud PCs" style="text;html=1;fontFamily=Segoe UI;fontSize=30;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="45" y="20" width="1700" height="50" as="geometry"/></mxCell>
<mxCell id="subtitle" value="Pilot-group assignments, workload delivery, Cloud PC check-in, reporting, and Windows update content flow" style="text;html=1;fontFamily=Segoe UI;fontSize=16;fontColor=#5C6675;" vertex="1" parent="1"><mxGeometry x="45" y="70" width="1500" height="35" as="geometry"/></mxCell>
