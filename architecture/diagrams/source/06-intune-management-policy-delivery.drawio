<mxCell id="admin" value="&lt;b&gt;1. IT administrator&lt;/b&gt;&lt;br&gt;&lt;br&gt;Creates, assigns, monitors, and remediates" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=14;fillColor=#FFFFFF;strokeColor=#8A94A6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="70" y="205" width="210" height="125" as="geometry"/></mxCell>
<mxCell id="intune" value="&lt;b&gt;2. Microsoft Intune admin center&lt;/b&gt;&lt;br&gt;&lt;br&gt;Windows device management&lt;br&gt;Policy and application control&lt;br&gt;Cloud PC inventory and remote Sync" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=14;fillColor=#EEF8FF;strokeColor=#0078D4;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="350" y="190" width="315" height="155" as="geometry"/></mxCell>
<mxCell id="groups" value="&lt;b&gt;3. Microsoft Entra groups&lt;/b&gt;&lt;br&gt;&lt;br&gt;W365-ENT-Pilot-Devices&lt;br&gt;W365-ENT-Pilot-Users&lt;br&gt;Assignment scope: device or user" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=14;fillColor=#F8F4FC;strokeColor=#744DA9;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="750" y="190" width="350" height="155" as="geometry"/></mxCell>
<mxCell id="reports" value="&lt;b&gt;6. Intune reporting&lt;/b&gt;&lt;br&gt;&lt;br&gt;Device and user status&lt;br&gt;Per-setting and compliance status&lt;br&gt;App and update deployment status" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=14;fillColor=#F7F9FB;strokeColor=#8A94A6;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1430" y="190" width="365" height="155" as="geometry"/></mxCell>
<mxCell id="workloads" value="&lt;b&gt;4. Intune workloads assigned to the pilot groups&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=14;spacingLeft=20;fontFamily=Segoe UI;fontSize=17;fontStyle=1;fillColor=#FFFFFF;strokeColor=#0078D4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="100" y="410" width="1670" height="205" as="geometry"/></mxCell>
<mxCell id="config" value="&lt;b&gt;Configuration profiles&lt;/b&gt;&lt;br&gt;Settings Catalog&lt;br&gt;&lt;font color='#107C10'&gt;Tested: Edge and wallpaper&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=14;fillColor=#EEF8FF;strokeColor=#0078D4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="135" y="470" width="285" height="115" as="geometry"/></mxCell>
