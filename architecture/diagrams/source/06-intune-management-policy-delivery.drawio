<mxCell id="apps" value="&lt;b&gt;Applications&lt;/b&gt;&lt;br&gt;Required, Available, Uninstall&lt;br&gt;&lt;font color='#107C10'&gt;Tested: Store apps / Company Portal&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=14;fillColor=#F2FBF2;strokeColor=#107C10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1095" y="470" width="285" height="115" as="geometry"/></mxCell>
<mxCell id="updates" value="&lt;b&gt;Windows Update ring&lt;/b&gt;&lt;br&gt;Deferrals, deadlines, restart UX&lt;br&gt;&lt;font color='#CA5010'&gt;Pilot created; before/after pending&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=14;fillColor=#FFFAF5;strokeColor=#CA5010;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1415" y="470" width="320" height="115" as="geometry"/></mxCell>
