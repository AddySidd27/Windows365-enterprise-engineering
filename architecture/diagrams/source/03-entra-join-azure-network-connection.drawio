<mxCell id="t85" value="Possible destinations" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontFamily=Segoe UI;fontSize=17;fontColor=#172b4d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2015" y="531" width="221" height="22" as="geometry"/></mxCell>
<mxCell id="t86" value="(set by your routes)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontFamily=Segoe UI;fontSize=14;fontColor=#364152;" vertex="1" parent="1"><mxGeometry x="2048" y="556" width="155" height="18" as="geometry"/></mxCell>
<mxCell id="t87" value="Internet" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontFamily=Segoe UI;fontSize=17;fontColor=#172b4d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2078" y="617" width="94" height="22" as="geometry"/></mxCell>
<mxCell id="t88" value="Your outbound path" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontFamily=Segoe UI;fontSize=15;fontColor=#364152;" vertex="1" parent="1"><mxGeometry x="2043" y="644" width="163" height="20" as="geometry"/></mxCell>
<mxCell id="t89" value="Private Azure" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontFamily=Segoe UI;fontSize=17;fontColor=#172b4d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2052" y="747" width="146" height="22" as="geometry"/></mxCell>
<mxCell id="t90" value="Azure apps, services" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontFamily=Segoe UI;fontSize=15;fontColor=#364152;" vertex="1" parent="1"><mxGeometry x="2040" y="774" width="171" height="20" as="geometry"/></mxCell>
<mxCell id="t91" value="On-premises" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontFamily=Segoe UI;fontSize=17;fontColor=#172b4d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2056" y="865" width="137" height="22" as="geometry"/></mxCell>
<mxCell id="t92" value="Optional VPN or" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontFamily=Segoe UI;fontSize=15;fontColor=#364152;" vertex="1" parent="1"><mxGeometry x="2058" y="892" width="135" height="20" as="geometry"/></mxCell>
<mxCell id="t93" value="ExpressRoute" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontFamily=Segoe UI;fontSize=15;fontColor=#364152;" vertex="1" parent="1"><mxGeometry x="2066" y="917" width="118" height="20" as="geometry"/></mxCell>
<mxCell id="t94" value="Terms used in this diagram" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontFamily=Segoe UI;fontSize=17;fontColor=#172b4d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="73" y="995" width="276" height="22" as="geometry"/></mxCell>
<mxCell id="t95" value="DNS (Domain Name System): turns names into IP addresses." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontFamily=Segoe UI;fontSize=14;fontColor=#364152;" vertex="1" parent="1"><mxGeometry x="73" y="1028" width="443" height="18" as="geometry"/></mxCell>
<mxCell id="t96" value="NSG (network security group): allow or deny rules for network traffic." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontFamily=Segoe UI;fontSize=14;fontColor=#364152;" vertex="1" parent="1"><mxGeometry x="73" y="1054" width="501" height="18" as="geometry"/></mxCell>
<mxCell id="t97" value="UDR (user-defined route): your own route that overrides default routing." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontFamily=Segoe UI;fontSize=14;fontColor=#364152;" vertex="1" parent="1"><mxGeometry x="73" y="1080" width="522" height="18" as="geometry"/></mxCell>
<mxCell id="t98" value="Firewall / NVA (network virtual appliance): a firewall or inspection device you run." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontFamily=Segoe UI;fontSize=14;fontColor=#364152;" vertex="1" parent="1"><mxGeometry x="73" y="1106" width="586" height="18" as="geometry"/></mxCell>
<mxCell id="t99" value="NAT gateway: outbound internet access; new ANC VNets need an explicit outbound method." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontFamily=Segoe UI;fontSize=14;fontColor=#364152;" vertex="1" parent="1"><mxGeometry x="73" y="1132" width="663" height="18" as="geometry"/></mxCell>
<mxCell id="t100" value="ANC (Azure network connection): tells Windows 365 which subscription, VNet, and subnet to use." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontFamily=Segoe UI;fontSize=14;fontColor=#364152;" vertex="1" parent="1"><mxGeometry x="1121" y="1028" width="698" height="18" as="geometry"/></mxCell>
<mxCell id="t101" value="VNet: virtual network.  NIC: virtual network card of the Cloud PC." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontFamily=Segoe UI;fontSize=14;fontColor=#364152;" vertex="1" parent="1"><mxGeometry x="1121" y="1054" width="470" height="18" as="geometry"/></mxCell>
<mxCell id="t102" value="AVD (Azure Virtual Desktop) gateway and broker: route the session and match user to Cloud PC." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontFamily=Segoe UI;fontSize=14;fontColor=#364152;" vertex="1" parent="1"><mxGeometry x="1121" y="1080" width="691" height="18" as="geometry"/></mxCell>
<mxCell id="t103" value="Reverse connect: the Cloud PC dials out, so no inbound port is opened." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontFamily=Segoe UI;fontSize=14;fontColor=#364152;" vertex="1" parent="1"><mxGeometry x="1121" y="1106" width="514" height="18" as="geometry"/></mxCell>
<mxCell id="t104" value="The Azure network connection tells Windows 365 which subscription, virtual network, and subnet to place the Cloud PC NIC in." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontFamily=Segoe UI;fontSize=16;fontColor=#172b4d;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="542" y="1214" width="1165" height="21" as="geometry"/></mxCell>
<mxCell id="t105" value="Only the NIC is in your subscription; the Cloud PC compute stays in the Microsoft-managed subscription." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontFamily=Segoe UI;fontSize=15;fontColor=#364152;" vertex="1" parent="1"><mxGeometry x="725" y="1243" width="800" height="20" as="geometry"/></mxCell>
<mxCell id="t106" value="You manage IP capacity, DNS, routing, security, private connectivity, and internet egress. Send required Windows 365 and AVD" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontFamily=Segoe UI;fontSize=15;fontColor=#364152;" vertex="1" parent="1"><mxGeometry x="639" y="1271" width="972" height="20" as="geometry"/></mxCell>
<mxCell id="t107" value="service traffic directly to Microsoft's network; do not route it through on-premises egress." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontFamily=Segoe UI;fontSize=15;fontColor=#364152;" vertex="1" parent="1"><mxGeometry x="782" y="1299" width="686" height="20" as="geometry"/></mxCell>
<mxCell id="t108" value="Source: Microsoft Learn, Windows 365 network deployment options (learn.microsoft.com/windows-365/enterprise/windows-365-network-deployment-options)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=nowrap;spacing=0;fontFamily=Segoe UI;fontSize=13;fontColor=#5c6675;" vertex="1" parent="1"><mxGeometry x="51" y="1354" width="1042" height="17" as="geometry"/></mxCell>
