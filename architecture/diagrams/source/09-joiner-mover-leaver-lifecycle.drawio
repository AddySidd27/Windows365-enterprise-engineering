<mxfile host="app.diagrams.net" modified="2026-09-04T00:00:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="w365-jml" name="Windows 365 JML Lifecycle">
    <mxGraphModel dx="1900" dy="1120" grid="1" gridSize="10" guides="1" page="1" pageWidth="1900" pageHeight="1120">
      <root>
        <mxCell id="0"/><mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b&gt;Windows 365 Enterprise Joiner, Mover, and Leaver Lifecycle&lt;/b&gt;&lt;br&gt;&lt;font color='#5C6675' size='3'&gt;Identity-driven eligibility, controlled persona changes, immediate access removal, grace period, and deprovisioning&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=28;" vertex="1" parent="1"><mxGeometry x="45" y="25" width="1500" height="75" as="geometry"/></mxCell>
        <mxCell id="plane" value="&lt;b&gt;Customer identity and assignment plane&lt;/b&gt;" style="swimlane;html=1;rounded=1;startSize=55;fontFamily=Segoe UI;fontSize=20;fontStyle=1;fillColor=#F7F9FC;strokeColor=#264A8A;strokeWidth=3;horizontal=1;" vertex="1" parent="1"><mxGeometry x="35" y="125" width="1830" height="245" as="geometry"/></mxCell>
        <mxCell id="source" value="&lt;b&gt;1. Authoritative identity source&lt;/b&gt;&lt;br&gt;&lt;br&gt;Join, role change, or departure&lt;br&gt;&lt;font color='#5C6675'&gt;Approved attributes and effective date&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=14;fillColor=#FFFFFF;strokeColor=#8A94A6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="75" y="200" width="285" height="120" as="geometry"/></mxCell>
        <mxCell id="user" value="&lt;b&gt;&lt;font color='#744DA9'&gt;2. Microsoft Entra ID user&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Account and lifecycle attributes&lt;br&gt;&lt;font color='#5C6675'&gt;Identity state drives group membership&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=14;fillColor=#F7F2FB;strokeColor=#744DA9;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="420" y="200" width="285" height="120" as="geometry"/></mxCell>
        <mxCell id="groups" value="&lt;b&gt;&lt;font color='#744DA9'&gt;3. Separate Microsoft Entra groups&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Persona eligibility | Windows 365 license SKU&lt;br&gt;Provisioning policy | User apps and settings&lt;br&gt;&lt;font color='#5C6675'&gt;Use discrete groups and avoid overlapping provisioning assignments&lt;br&gt;Provisioning-policy assignments do not support nested groups&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=13;fillColor=#F7F2FB;strokeColor=#744DA9;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="765" y="185" width="430" height="150" as="geometry"/></mxCell>
        <mxCell id="control" value="&lt;b&gt;&lt;font color='#2563A9'&gt;4. Windows 365 and Microsoft Intune control plane&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Checks the Windows 365 license and provisioning-policy assignment&lt;br&gt;Provisions the Cloud PC, enrolls it, applies policy, and reports status&lt;br&gt;&lt;font color='#5C6675'&gt;Customer configuration; Cloud PC compute remains Microsoft hosted&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=14;fillColor=#EEF8FF;strokeColor=#0078D4;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1260" y="185" width="545" height="150" as="geometry"/></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563A9;strokeWidth=5;endArrow=block;endFill=1;" edge="1" parent="1" source="source" target="user"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#744DA9;strokeWidth=5;endArrow=block;endFill=1;" edge="1" parent="1" source="user" target="groups"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#744DA9;strokeWidth=5;endArrow=block;endFill=1;" edge="1" parent="1" source="groups" target="control"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="joinLane" value="&lt;b&gt;&lt;font color='#2563A9'&gt;JOINER — create controlled access&lt;/font&gt;&lt;/b&gt;" style="swimlane;html=1;rounded=1;startSize=60;fontFamily=Segoe UI;fontSize=20;fontStyle=1;fillColor=#F7FBFF;strokeColor=#0078D4;strokeWidth=3;horizontal=1;" vertex="1" parent="1"><mxGeometry x="35" y="400" width="565" height="625" as="geometry"/></mxCell>
        <mxCell id="j1" value="&lt;b&gt;1. Identity and attributes are ready&lt;/b&gt;&lt;br&gt;&lt;font color='#5C6675'&gt;Manager, persona, location, and start date are validated&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=14;fillColor=#FFFFFF;strokeColor=#744DA9;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="85" y="475" width="465" height="78" as="geometry"/></mxCell>
        <mxCell id="j2" value="&lt;b&gt;&lt;font color='#744DA9'&gt;2. Assign the correct control groups&lt;/font&gt;&lt;/b&gt;&lt;br&gt;License SKU + provisioning policy + persona access&lt;br&gt;&lt;font color='#5C6675'&gt;Both license and provisioning eligibility are required&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=14;fillColor=#F7F2FB;strokeColor=#744DA9;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="85" y="585" width="465" height="92" as="geometry"/></mxCell>
        <mxCell id="j3" value="&lt;b&gt;&lt;font color='#2563A9'&gt;3. Windows 365 provisions the Cloud PC&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Policy selects network, image, region, join type, and SSO&lt;br&gt;&lt;font color='#5C6675'&gt;Monitor Provisioning, Failed, or Provisioned with warnings&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=14;fillColor=#EEF8FF;strokeColor=#0078D4;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="85" y="709" width="465" height="92" as="geometry"/></mxCell>
        <mxCell id="j4" value="&lt;b&gt;&lt;font color='#107C10'&gt;4. Entra joined and Intune enrolled&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color='#5C6675'&gt;Apply device policy, apps, security, compliance, and updates&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=14;fillColor=#F2FBF2;strokeColor=#107C10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="85" y="833" width="465" height="78" as="geometry"/></mxCell>
        <mxCell id="j5" value="&lt;b&gt;&lt;font color='#107C10'&gt;5. Validate user connection and baseline&lt;/font&gt;&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=14;fillColor=#F2FBF2;strokeColor=#107C10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="85" y="941" width="465" height="58" as="geometry"/></mxCell>
        <mxCell id="je1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563A9;strokeWidth=4;endArrow=block;endFill=1;" edge="1" parent="1" source="j1" target="j2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="je2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563A9;strokeWidth=4;endArrow=block;endFill=1;" edge="1" parent="1" source="j2" target="j3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="je3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#107C10;strokeWidth=4;endArrow=block;endFill=1;" edge="1" parent="1" source="j3" target="j4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="je4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#107C10;strokeWidth=4;endArrow=block;endFill=1;" edge="1" parent="1" source="j4" target="j5"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="moveLane" value="&lt;b&gt;&lt;font color='#CA5010'&gt;MOVER — select the least disruptive action&lt;/font&gt;&lt;/b&gt;" style="swimlane;html=1;rounded=1;startSize=60;fontFamily=Segoe UI;fontSize=20;fontStyle=1;fillColor=#FFFAF5;strokeColor=#CA5010;strokeWidth=3;horizontal=1;" vertex="1" parent="1"><mxGeometry x="630" y="400" width="610" height="625" as="geometry"/></mxCell>
        <mxCell id="m1" value="&lt;b&gt;1. Approved persona or role change&lt;/b&gt;&lt;br&gt;&lt;font color='#5C6675'&gt;Compare target license, network, image, apps, and access&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=14;fillColor=#FFFFFF;strokeColor=#744DA9;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="680" y="475" width="510" height="78" as="geometry"/></mxCell>
        <mxCell id="decision" value="&lt;b&gt;&lt;font color='#CA5010'&gt;Can the current Cloud PC&lt;br&gt;meet the target state?&lt;/font&gt;&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=14;fillColor=#FFF4E8;strokeColor=#CA5010;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="790" y="585" width="290" height="130" as="geometry"/></mxCell>
        <mxCell id="preserve" value="&lt;b&gt;&lt;font color='#107C10'&gt;Preserve&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Update apps and access&lt;br&gt;Resize compute if required&lt;br&gt;&lt;font color='#5C6675'&gt;Validate before source removal&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=14;fillColor=#F2FBF2;strokeColor=#107C10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="675" y="745" width="245" height="145" as="geometry"/></mxCell>
        <mxCell id="change" value="&lt;b&gt;&lt;font color='#CA5010'&gt;Change platform state&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Move: supported region / network&lt;br&gt;Reprovision: image change&lt;br&gt;New Cloud PC: join-type change&lt;br&gt;&lt;font color='#5C6675'&gt;Protect data before destructive work&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=13;fillColor=#FFF4E8;strokeColor=#CA5010;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="950" y="745" width="245" height="145" as="geometry"/></mxCell>
        <mxCell id="m2" value="&lt;b&gt;&lt;font color='#107C10'&gt;2. Validate target state; then remove stale access&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color='#5C6675'&gt;Do not assume a provisioning-policy edit changes every existing Cloud PC&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=14;fillColor=#F2FBF2;strokeColor=#107C10;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="680" y="941" width="510" height="58" as="geometry"/></mxCell>
        <mxCell id="me1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#CA5010;strokeWidth=4;endArrow=block;endFill=1;" edge="1" parent="1" source="m1" target="decision"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="me2" value="Yes" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#107C10;strokeWidth=4;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=12;fontColor=#107C10;" edge="1" parent="1" source="decision" target="preserve"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="me3" value="No" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#CA5010;strokeWidth=4;endArrow=block;endFill=1;fontFamily=Segoe UI;fontSize=12;fontColor=#CA5010;" edge="1" parent="1" source="decision" target="change"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="me4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#107C10;strokeWidth=4;endArrow=block;endFill=1;" edge="1" parent="1" source="preserve" target="m2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="me5" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#CA5010;strokeWidth=4;endArrow=block;endFill=1;" edge="1" parent="1" source="change" target="m2"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="leaveLane" value="&lt;b&gt;&lt;font color='#C50F1F'&gt;LEAVER — block access, retain data, deprovision&lt;/font&gt;&lt;/b&gt;" style="swimlane;html=1;rounded=1;startSize=60;fontFamily=Segoe UI;fontSize=20;fontStyle=1;fillColor=#FFF8F8;strokeColor=#C50F1F;strokeWidth=3;horizontal=1;" vertex="1" parent="1"><mxGeometry x="1270" y="400" width="595" height="625" as="geometry"/></mxCell>
        <mxCell id="l1" value="&lt;b&gt;&lt;font color='#C50F1F'&gt;1. Block sign-in and revoke active sessions&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color='#5C6675'&gt;Immediate access control is separate from Cloud PC deletion&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=14;fillColor=#FFFFFF;strokeColor=#C50F1F;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1320" y="475" width="495" height="78" as="geometry"/></mxCell>
        <mxCell id="l2" value="&lt;b&gt;2. Preserve approved business data and evidence&lt;/b&gt;&lt;br&gt;&lt;font color='#5C6675'&gt;Follow retention, legal hold, and offboarding requirements&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=14;fillColor=#FFFFFF;strokeColor=#8A94A6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1320" y="581" width="495" height="78" as="geometry"/></mxCell>
        <mxCell id="l3" value="&lt;b&gt;&lt;font color='#CA5010'&gt;3. Remove license or provisioning assignment&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color='#5C6675'&gt;Enterprise Cloud PC enters grace period&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=14;fillColor=#FFF4E8;strokeColor=#CA5010;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1320" y="687" width="495" height="78" as="geometry"/></mxCell>
        <mxCell id="grace" value="&lt;b&gt;&lt;font color='#CA5010'&gt;4. Seven-day grace period&lt;/font&gt;&lt;/b&gt;&lt;br&gt;User can continue unless account access was already blocked&lt;br&gt;Restore the removed license or assignment to recover the Cloud PC&lt;br&gt;&lt;font color='#5C6675'&gt;Provisioned and grace-period Cloud PCs both consume active capacity&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=14;fillColor=#FFF4E8;strokeColor=#CA5010;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1320" y="785" width="495" height="110" as="geometry"/></mxCell>
        <mxCell id="restored" value="&lt;b&gt;&lt;font color='#107C10'&gt;Eligibility restored&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color='#107C10'&gt;Provisioned; Cloud PC retained&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=13;fillColor=#F2FBF2;strokeColor=#107C10;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1320" y="925" width="245" height="75" as="geometry"/></mxCell>
        <mxCell id="delete" value="&lt;b&gt;&lt;font color='#C50F1F'&gt;Grace expires or&lt;br&gt;Deprovision now&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color='#C50F1F'&gt;Data deleted; capacity released&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=12;fillColor=#FFF0F1;strokeColor=#C50F1F;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1580" y="925" width="235" height="75" as="geometry"/></mxCell>
        <mxCell id="le1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#C50F1F;strokeWidth=4;endArrow=block;endFill=1;" edge="1" parent="1" source="l1" target="l2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#CA5010;strokeWidth=4;endArrow=block;endFill=1;" edge="1" parent="1" source="l2" target="l3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#CA5010;strokeWidth=4;endArrow=block;endFill=1;" edge="1" parent="1" source="l3" target="grace"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="le4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#C50F1F;strokeWidth=4;endArrow=block;endFill=1;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="grace" target="delete"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="restore" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#107C10;strokeWidth=4;endArrow=block;endFill=1;exitX=0.28;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="grace" target="restored"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="legendBg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F9FC;strokeColor=#D0D5DD;" vertex="1" parent="1"><mxGeometry x="45" y="1045" width="1810" height="45" as="geometry"/></mxCell>
        <mxCell id="legendBlue" value="●  Customer control" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=12;fontColor=#2563A9;" vertex="1" parent="1"><mxGeometry x="75" y="1052" width="170" height="30" as="geometry"/></mxCell>
        <mxCell id="legendPurple" value="●  Identity and groups" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=12;fontColor=#744DA9;" vertex="1" parent="1"><mxGeometry x="250" y="1052" width="190" height="30" as="geometry"/></mxCell>
        <mxCell id="legendGreen" value="●  Preserved or validated" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=12;fontColor=#107C10;" vertex="1" parent="1"><mxGeometry x="445" y="1052" width="215" height="30" as="geometry"/></mxCell>
        <mxCell id="legendOrange" value="●  Controlled change" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=12;fontColor=#CA5010;" vertex="1" parent="1"><mxGeometry x="665" y="1052" width="175" height="30" as="geometry"/></mxCell>
        <mxCell id="legendRed" value="●  Access block or destructive action" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Segoe UI;fontSize=12;fontColor=#C50F1F;" vertex="1" parent="1"><mxGeometry x="840" y="1052" width="270" height="30" as="geometry"/></mxCell>
        <mxCell id="legendNote" value="Microsoft Learn verified • Windows 365 Enterprise scope" style="text;html=1;align=right;verticalAlign=middle;fontFamily=Segoe UI;fontSize=12;fontColor=#5C6675;" vertex="1" parent="1"><mxGeometry x="1420" y="1052" width="395" height="30" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
