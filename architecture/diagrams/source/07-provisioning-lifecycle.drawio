<mxfile host="app.diagrams.net" modified="2026-09-03T00:00:00.000Z" agent="Codex" version="24.7.17">
  <diagram id="w365-provisioning-lifecycle" name="Provisioning Lifecycle">
    <mxGraphModel dx="1900" dy="1100" grid="1" gridSize="10" guides="1" page="1" pageWidth="1900" pageHeight="1100">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Windows 365 Enterprise Provisioning Lifecycle" style="text;html=1;fontFamily=Segoe UI;fontSize=30;fontStyle=1;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="45" y="20" width="1500" height="50" as="geometry"/></mxCell>
        <mxCell id="subtitle" value="Pilot flow: licensed user and policy assignment through automated provisioning, Intune enrollment, and user access" style="text;html=1;fontFamily=Segoe UI;fontSize=16;fontColor=#5C6675;" vertex="1" parent="1"><mxGeometry x="45" y="70" width="1600" height="35" as="geometry"/></mxCell>

        <mxCell id="tenant" value="&lt;b&gt;Customer tenant inputs&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=16;spacingLeft=22;fontFamily=Segoe UI;fontSize=20;fontStyle=1;fillColor=#F7F9FC;strokeColor=#264A8A;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="35" y="125" width="1830" height="245" as="geometry"/></mxCell>
        <mxCell id="user" value="&lt;b&gt;1. Licensed pilot user&lt;/b&gt;&lt;br&gt;&lt;br&gt;Windows 365 Enterprise license assigned&lt;br&gt;&lt;font color='#5C6675'&gt;License defines vCPU, RAM, and storage&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=14;fillColor=#EEF8FF;strokeColor=#0078D4;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="80" y="195" width="390" height="130" as="geometry"/></mxCell>
        <mxCell id="policy" value="&lt;b&gt;2. Provisioning policy: W365-ENT-PP-MHN-Pilot&lt;/b&gt;&lt;br&gt;&lt;br&gt;Enterprise • Full Cloud PC desktop • Microsoft Entra join • Microsoft-hosted network&lt;br&gt;Geography and region strategy • Gallery image • Language and region • Microsoft Entra SSO&lt;br&gt;&lt;font color='#5C6675'&gt;The provisioning policy does not define Cloud PC compute size&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=14;fillColor=#F7F2FB;strokeColor=#744DA9;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="545" y="195" width="760" height="130" as="geometry"/></mxCell>
        <mxCell id="group" value="&lt;b&gt;3. Assigned user group&lt;/b&gt;&lt;br&gt;&lt;br&gt;W365-ENT-Pilot-Provisioning&lt;br&gt;&lt;font color='#5C6675'&gt;Dedicated provisioning-policy group&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=14;fillColor=#F7F2FB;strokeColor=#744DA9;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1380" y="195" width="400" height="130" as="geometry"/></mxCell>

        <mxCell id="eligibility" value="&lt;b&gt;&lt;font color='#2563A9'&gt;4. Windows 365 eligibility evaluation&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;User has the correct license and matches the provisioning-policy assignment&lt;br&gt;&lt;font color='#5C6675'&gt;For Enterprise, avoid overlaps: the first assigned provisioning policy is used&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=14;fillColor=#FFFFFF;strokeColor=#2563A9;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="655" y="390" width="590" height="105" as="geometry"/></mxCell>

        <mxCell id="service" value="&lt;b&gt;Windows 365 service — automated provisioning&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;spacingTop=16;spacingLeft=22;fontFamily=Segoe UI;fontSize=20;fontStyle=1;fillColor=#F7FBFF;strokeColor=#0078D4;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="35" y="550" width="1830" height="365" as="geometry"/></mxCell>
        <mxCell id="core" value="&lt;b&gt;&lt;font color='#2563A9'&gt;5A. Core provisioning&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Allocate Azure capacity in the selected region&lt;br&gt;2. Create the VM from the user's license specifications&lt;br&gt;3. Create and attach the NIC to the Microsoft-hosted network&lt;br&gt;4. Join the device to Microsoft Entra ID&lt;br&gt;5. Enroll the Cloud PC in Intune and assign its primary user" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=35;fontFamily=Segoe UI;fontSize=14;fillColor=#EEF8FF;strokeColor=#0078D4;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="85" y="625" width="690" height="235" as="geometry"/></mxCell>
        <mxCell id="post" value="&lt;b&gt;&lt;font color='#107C10'&gt;5B. Post-provisioning configuration&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Windows 365 applies Cloud PC&lt;br&gt;experience and security optimizations&lt;br&gt;&lt;br&gt;&lt;font color='#5C6675'&gt;Examples: shutdown/reset controls, Teams VDI mode,&lt;br&gt;time-zone redirection, disk sizing, OneDrive policies&lt;/font&gt;&lt;br&gt;&lt;font color='#CA5010'&gt;An optimization failure can finish as Success with warnings&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=14;fillColor=#F2FBF2;strokeColor=#107C10;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="875" y="625" width="440" height="235" as="geometry"/></mxCell>
        <mxCell id="assignment" value="&lt;b&gt;&lt;font color='#107C10'&gt;5C. User assignment&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Windows 365 assigns the user&lt;br&gt;to the completed Cloud PC&lt;br&gt;&lt;br&gt;Status: Provisioned&lt;br&gt;&lt;font color='#5C6675'&gt;The Cloud PC is ready for sign-in&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=14;fillColor=#F2FBF2;strokeColor=#107C10;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="1415" y="625" width="365" height="235" as="geometry"/></mxCell>

        <mxCell id="failure" value="&lt;b&gt;&lt;font color='#CA5010'&gt;Provisioning failure path&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Windows 365 retries automatically twice; after the third failure, status becomes Failed&lt;br&gt;&lt;font color='#5C6675'&gt;Fix the root cause, then use Retry. Do not reprovision before evidence is captured.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=14;fillColor=#FFFAF5;strokeColor=#CA5010;strokeWidth=3;" vertex="1" parent="1"><mxGeometry x="80" y="940" width="820" height="90" as="geometry"/></mxCell>
        <mxCell id="outcome" value="&lt;b&gt;&lt;font color='#107C10'&gt;6. Provisioned Cloud PC available to the user&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;br&gt;Intune-managed device • Windows App • windows.cloud.microsoft&lt;br&gt;&lt;font color='#5C6675'&gt;Validate Entra join, Intune record, expected image/build, primary user, and connection&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=14;fillColor=#F2FBF2;strokeColor=#107C10;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="1050" y="925" width="730" height="105" as="geometry"/></mxCell>
        <mxCell id="note1" value="Operational note: provisioning-policy edits affect newly provisioned or reprovisioned Cloud PCs; they do not rebuild existing Cloud PCs." style="text;html=1;fontFamily=Segoe UI;fontSize=12;fontColor=#5C6675;align=center;" vertex="1" parent="1"><mxGeometry x="300" y="1047" width="1300" height="25" as="geometry"/></mxCell>
        <mxCell id="note2" value="Microsoft Learn basis: Provisioning overview, Create provisioning policies, Automated provisioning steps, Assign licenses, and Windows 365 architecture." style="text;html=1;fontFamily=Segoe UI;fontSize=12;fontColor=#5C6675;align=center;" vertex="1" parent="1"><mxGeometry x="260" y="1072" width="1380" height="25" as="geometry"/></mxCell>

        <mxCell id="e-user" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563A9;strokeWidth=4;endArrow=block;endFill=1;" edge="1" parent="1" source="user" target="eligibility"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="275" y="420"/><mxPoint x="655" y="420"/></Array></mxGeometry></mxCell>
        <mxCell id="e-policy" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#744DA9;strokeWidth=4;endArrow=block;endFill=1;" edge="1" parent="1" source="policy" target="eligibility"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-group" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#744DA9;strokeWidth=4;endArrow=block;endFill=1;" edge="1" parent="1" source="group" target="eligibility"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1580" y="420"/><mxPoint x="1245" y="420"/></Array></mxGeometry></mxCell>
        <mxCell id="e-start" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563A9;strokeWidth=5;endArrow=block;endFill=1;" edge="1" parent="1" source="eligibility" target="core"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-core" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2563A9;strokeWidth=5;endArrow=block;endFill=1;" edge="1" parent="1" source="core" target="post"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-post" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#107C10;strokeWidth=5;endArrow=block;endFill=1;" edge="1" parent="1" source="post" target="assignment"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-outcome" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#107C10;strokeWidth=5;endArrow=block;endFill=1;" edge="1" parent="1" source="assignment" target="outcome"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e-failure" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#CA5010;strokeWidth=4;dashed=1;dashPattern=9 7;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.43;entryY=0;" edge="1" parent="1" source="core" target="failure"><mxGeometry relative="1" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
